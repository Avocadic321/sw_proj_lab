@startuml UC4_MovePlayer
title UC-4: Move Player

skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam maxmessagesize 220
skinparam defaultFontSize 12

actor "Player" as player
participant "game:Game" as game
participant "currentElement:Element" as currentElement
participant "targetElement:Element" as targetElement

player -> game : selectTargetAdjacentElement(targetElement)
player -> game : moveTo(targetElement)

game -> game : isDirectlyConnected(currentElement,targetElement)
game -> targetElement : canOccupy()
targetElement --> game : true/false

alt target connected and occupiable
    game -> currentElement : removeOccupant(player)
    game -> targetElement : addOccupant(player)
    player -> player : position=targetElement
    game --> player : moveTo() returns true
else target invalid or occupied
    game --> player : moveTo() returns false
    note over game : If occupancy violates single-player-on-pipe,
    note over game : movement is rejected (deadlock-avoidance rule).
end

@enduml