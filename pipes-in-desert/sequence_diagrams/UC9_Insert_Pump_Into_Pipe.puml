@startuml UC9_InsertPumpIntoPipe
title UC-9: Insert Pump Into Pipe

skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam maxmessagesize 220
skinparam defaultFontSize 12

actor "Plumber" as plumber
participant "game:Game" as game
participant "activePlumber:Plumber" as activePlumber
participant "targetPipe:Pipe" as targetPipe
participant "carriedPump:Pump" as carriedPump

plumber -> game : selectPipe(targetPipe)
plumber -> game : insertPumpIntoPipe(targetPipe)
game -> activePlumber : getCarriedItem()
activePlumber --> game : carriedPump
game -> targetPipe : splitForPump(carriedPump)
targetPipe --> game : leftPipe,rightPipe
game -> carriedPump : setDirection(leftPipe,rightPipe)
game -> activePlumber : clearCarriedItem()
game -> game : updateConnections()
game --> plumber : insertionComplete

@enduml