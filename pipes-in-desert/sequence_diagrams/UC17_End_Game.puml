
@startuml UC17_EndGame
title UC-17: End Game

skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam maxmessagesize 220
skinparam defaultFontSize 12

participant "game:Game" as game
participant "plumberTeam:Team" as plumberTeam
participant "saboteurTeam:Team" as saboteurTeam

loop periodic check during running game
    game -> game : checkWinner()

    game -> plumberTeam : getScore()
    plumberTeam --> game : plumberScore
    game -> saboteurTeam : getScore()
    saboteurTeam --> game : saboteurScore

    game -> game : compareScores(plumberScore, saboteurScore)

    alt one team reached or exceeded goalScore
        game -> game : determineWinner()
        game -> game : ensureNoDrawCondition()
        game -> game : state=FINISHED
        game -> game : displayFinalResult(winner)
    else no winner yet
        game --> game : keep running
    end
end

@enduml
