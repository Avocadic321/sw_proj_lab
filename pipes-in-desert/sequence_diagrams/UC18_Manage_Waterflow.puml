
@startuml UC18_ManageWaterflow
title UC-18: Manage Waterflow

skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam maxmessagesize 220
skinparam defaultFontSize 12
skinparam noteFontSize 11
skinparam sequenceLifeLineBorderColor #444444
skinparam participantBorderColor #333333

participant "game:Game" as game
participant "sourceSpring:Spring" as sourceSpring
participant "activePipe:Pipe" as activePipe
participant "activePump:Pump" as activePump
participant "targetCistern:Cistern" as targetCistern

game -> game : simulateWaterFlow()
game -> game : getSprings()
game --> game : springList

loop for each sourceSpring in springList
    game -> sourceSpring : generateWater()
    sourceSpring --> game : waterAmount

    game -> sourceSpring : getConnectedPipes()
    sourceSpring --> game : pipeQueue

    loop while pipeQueue not empty
        game -> activePipe : isBroken()
        activePipe --> game : brokenState

        alt activePipe is broken
            note over game : Water leaks into desert.
            game -> game : registerLeak(activePipe)

        else activePipe has free end
            note over game : Water exits through free end.
            game -> game : registerLeak(activePipe)

        else activePipe is functional
            game -> activePipe : transferWater(waterAmount)
            activePipe --> game : forwardedAmount

            game -> activePipe : getNextPump()
            activePipe --> game : activePump

            game -> activePump : isBroken()
            activePump --> game : true/false

            alt activePump is broken
                note over game : Pump is broken, flow stops on this branch.

            else pump tank is full
                game -> activePump : isTankFull()
                activePump --> game : true
                note over game : Pump tank full, flow stops on this branch.

            else pump is working
                game -> activePump : transferWater(forwardedAmount)
                activePump --> game : pumpedAmount

                game -> activePump : getOutgoingPipe()
                activePump --> game : outgoingPipe
                game -> game : enqueuePipe(outgoingPipe)

                opt outgoing element is cistern
                    game -> targetCistern : receiveWater(pumpedAmount)
                    targetCistern --> game : stored
                end
            end
        end
    end
end

game -> game : updateFlowTotals(storedWaterTotal, leakedWaterTotal)

@enduml
