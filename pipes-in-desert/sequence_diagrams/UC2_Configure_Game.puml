@startuml UC2_ConfigureGame
title UC-2: Configure Game

skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam maxmessagesize 220
skinparam defaultFontSize 12

actor "Player" as player
participant "game:Game" as game
participant "turnTimer:Timer" as turnTimer
participant "plumberTeam:Team" as plumberTeam
participant "saboteurTeam:Team" as saboteurTeam

player -> game : initiateConfiguration()
game --> player : configurationRequested

player -> game : enterTargetScore(goalScore)
game -> game : setGoalScore(goalScore)

player -> game : enterTurnDuration(duration)
game -> turnTimer : setTurnDuration(duration)

player -> game : setNumberOfPlayers(playerCount)
loop assign each participating player
    game -> plumberTeam : addPlayer(player) or
    game -> saboteurTeam : addPlayer(player)
end

player -> game : setRealtimeScoring(enabled)
game -> game : storeRealtimeScoringSetting(enabled)

game -> game : validateConfiguration()

alt parameters valid
    game -> game : saveConfiguration()
    game --> player : configurationSaved
else parameters invalid
    game --> player : requestCorrectedInput
end

@enduml