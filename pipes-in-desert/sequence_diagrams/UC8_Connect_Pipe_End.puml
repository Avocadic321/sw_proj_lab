@startuml UC8_ConnectPipe
title UC-8: Connect Pipe End

skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam maxmessagesize 220
skinparam defaultFontSize 12

actor "Plumber" as plumber
participant "game:Game" as game
participant "selectedPipe:Pipe" as selectedPipe
participant "freeEnd:PipeEnd" as freeEnd
participant "targetElement:GameElement" as targetElement

plumber -> game : selectFreePipeEnd(freeEnd)
plumber -> game : selectTargetElement(targetElement)
plumber -> game : connect(selectedPipe, freeEnd, targetElement)
game -> freeEnd : isFree()
freeEnd --> game : true/false

alt end is free
    game -> targetElement : validateConnection(selectedPipe, freeEnd)
    targetElement --> game : valid/invalid

    alt valid connection
        game -> freeEnd : connectTo(targetElement)
        freeEnd --> game : connected
        game -> game : updatePipeNetworkStructure()
        game --> plumber : success
    else invalid connection
        game --> plumber : rejected
    end
else end already connected
    game --> plumber : rejected
end

@enduml